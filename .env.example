# Local demo mode runs without these values.
# The interface labels sample records and will not invent missing trial numbers.
NEXT_PUBLIC_DEMO_MODE=true

# Optional. When both are set, the login screen offers Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Recommended by NCBI for PubMed E-utilities. Searches still work with the demo contact.
NCBI_TOOL=maitu_oncotrial_atlas
NCBI_EMAIL=

# Literature routes are read-only. They never write efficacy numbers.
# Conference adapters remain off unless you have a licensed source.
ENABLE_CONFERENCE_ADAPTERS=false
